{
	email admin@hoc.agency
}

(hoc_api_routes) {
	handle /api* {
		root * /var/www/hoc/public
		encode zstd gzip
		request_body {
			max_size 512MB
		}
		php_fastcgi hoc-api:9000 {
			dial_timeout 10s
			read_timeout 10m
			write_timeout 10m
		}
		file_server
	}

	handle /auth* {
		root * /var/www/hoc/public
		encode zstd gzip
		php_fastcgi hoc-api:9000 {
			dial_timeout 10s
			read_timeout 10m
			write_timeout 10m
		}
		file_server
	}

	handle /up {
		root * /var/www/hoc/public
		php_fastcgi hoc-api:9000
	}

	handle /storage* {
		root * /var/www/hoc/storage/app/public
		uri strip_prefix /storage
		encode zstd gzip
		header {
			Accept-Ranges bytes
			Cache-Control "public, max-age=86400"
			Access-Control-Allow-Origin *
			Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		}
		file_server
	}
}

(hoc_app) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	@oldBase path /home-of-creativity-profile /home-of-creativity-profile/*
	handle @oldBase {
		uri strip_prefix /home-of-creativity-profile
		redir {scheme}://{host}{uri} permanent
	}

	import hoc_api_routes

	redir /staff /dashboard 308
	redir /staff/ /dashboard 308
	@oldStaff path_regexp oldstaff ^/staff(/.*)$
	redir @oldStaff /dashboard{re.oldstaff.1} 308

	redir /dashboard /dashboard/ 308

	handle_path /dashboard* {
		root * /var/www/hoc/dashboard/dist
		encode zstd gzip

		@dashboardStatic path *.js *.css *.mjs *.map *.woff *.woff2 *.ttf *.png *.jpg *.jpeg *.webp *.avif *.svg *.ico *.json *.txt *.webmanifest
		handle @dashboardStatic {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		header Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} {path}/ /index.html
		file_server
	}

	handle /sitemap.xml {
		root * /var/www/design
		encode zstd gzip
		header Content-Type "application/xml; charset=utf-8"
		file_server
	}

	@siteHashed path /_next/static/*
	handle @siteHashed {
		root * /var/www/design
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@siteAsset {
		path *.css *.js *.mjs *.map *.woff *.woff2 *.ttf *.png *.jpg *.jpeg *.webp *.avif *.svg *.ico *.txt *.xml *.webmanifest
		not path /dashboard /dashboard/*
	}
	handle @siteAsset {
		root * /var/www/design
		encode zstd gzip
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	handle {
		root * /var/www/design
		encode zstd gzip
		try_files {path} {path}/ {path}/index.html
		file_server
	}

	handle_errors {
		root * /var/www/design
		rewrite * /404.html
		file_server
	}
}

:80 {
	import hoc_app
}

www.hoc.agency {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	redir https://hoc.agency{uri} permanent
}

api.hoc.agency {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<EOF
User-agent: *
Disallow: /
EOF 200
	}

	import hoc_api_routes
}

hoc.agency {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	import hoc_app
}

{
	email admin@hoc.agency
}

(hoc_api_routes) {
	handle /api* {
		root * /var/www/hoc/public
		encode zstd gzip
		header -X-Powered-By
		request_body {
			max_size 512MB
		}
		php_fastcgi hoc-api:9000 {
			dial_timeout 10s
			read_timeout 10m
			write_timeout 10m
		}
		file_server
	}

	handle /auth* {
		root * /var/www/hoc/public
		encode zstd gzip
		php_fastcgi hoc-api:9000 {
			dial_timeout 10s
			read_timeout 10m
			write_timeout 10m
		}
		file_server
	}

	handle /up {
		root * /var/www/hoc/public
		php_fastcgi hoc-api:9000
	}

	# Staff replace these files. A long cache would keep the previous picture.
	handle /storage/portfolio/clients* {
		root * /var/www/hoc/storage/app/public
		uri strip_prefix /storage
		encode zstd gzip
		header {
			Accept-Ranges bytes
			Cache-Control "no-cache"
			Access-Control-Allow-Origin *
			Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		}
		file_server
	}

	handle /storage/portfolio/projects* {
		root * /var/www/hoc/storage/app/public
		uri strip_prefix /storage
		encode zstd gzip
		header {
			Accept-Ranges bytes
			Cache-Control "no-cache"
			Access-Control-Allow-Origin *
			Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		}
		file_server
	}

	handle /storage* {
		root * /var/www/hoc/storage/app/public
		uri strip_prefix /storage
		encode zstd gzip
		header {
			Accept-Ranges bytes
			Cache-Control "public, max-age=86400"
			Access-Control-Allow-Origin *
			Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		}
		file_server
	}
}

(hoc_app) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	@oldBase path /home-of-creativity-profile /home-of-creativity-profile/*
	handle @oldBase {
		uri strip_prefix /home-of-creativity-profile
		redir {scheme}://{host}{uri} permanent
	}

	import hoc_api_routes

	redir /staff /dashboard/ 308
	redir /staff/ /dashboard/ 308
	@oldStaff path_regexp oldstaff ^/staff(/.*)$
	redir @oldStaff /dashboard{re.oldstaff.1} 308

	redir /dashboard /dashboard/ 308

	handle_path /dashboard* {
		root * /var/www/hoc/dashboard/dist
		encode zstd gzip

		@dashboardStatic path *.js *.css *.mjs *.map *.woff *.woff2 *.ttf *.png *.jpg *.jpeg *.webp *.avif *.svg *.ico *.json *.txt *.webmanifest
		handle @dashboardStatic {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			header {
				Cache-Control "no-cache, no-store, must-revalidate"
				Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://api.hoc.agency https://*.ingest.de.sentry.io; frame-src 'self' blob: https://api.hoc.agency; object-src 'none'; base-uri 'self'"
				Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
			}
			try_files {path} {path}/ /index.html
			file_server
		}
	}

	handle /sitemap.xml {
		root * /var/www/design
		encode zstd gzip
		header Content-Type "application/xml; charset=utf-8"
		file_server
	}

	@siteHashed path /_next/static/*
	handle @siteHashed {
		root * /var/www/design
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@siteFresh path /sw.js /robots.txt /manifest.webmanifest /cms-version.txt
	handle @siteFresh {
		root * /var/www/design
		encode zstd gzip
		header Cache-Control "no-cache"
		file_server
	}

	# Build-time 240px WebP logos named by content hash: a new logo is a new URL.
	@clientLogos path /generated/clients/*
	handle @clientLogos {
		root * /var/www/design
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Rewritten with each build (prices, offices, articles); a month was too long.
	@siteDaily path /llms.txt /llms-full.txt
	handle @siteDaily {
		root * /var/www/design
		encode zstd gzip
		header Cache-Control "public, max-age=86400"
		file_server
	}

	@siteAsset {
		path *.css *.js *.mjs *.map *.woff *.woff2 *.ttf *.png *.jpg *.jpeg *.webp *.avif *.svg *.ico *.txt *.xml *.webmanifest *.mp4 *.webm
		not path /dashboard /dashboard/* /sw.js /robots.txt /manifest.webmanifest /cms-version.txt /llms.txt /llms-full.txt /generated/clients /generated/clients/*
	}
	handle @siteAsset {
		root * /var/www/design
		encode zstd gzip
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	# Seeded collage projects 1–6 stay on disk from an older export. 410 tells crawlers they are gone.
	@removedProjects path_regexp ^/projects/[1-6]/?$
	handle @removedProjects {
		header Cache-Control "no-cache"
		respond "Gone" 410
	}

	# Old project shell still receiving Search Console impressions.
	@removedProjectDetail path /projects/detail /projects/detail/
	handle @removedProjectDetail {
		header Cache-Control "no-cache"
		respond "Gone" 410
	}

	handle {
		root * /var/www/design
		encode zstd gzip
		header {
			Cache-Control "no-cache"
			Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https: https://*.googleapis.com https://*.gstatic.com; media-src 'self' blob: https:; script-src 'self' 'unsafe-inline' https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.hoc.agency https://maps.googleapis.com https://maps.gstatic.com https://*.ingest.de.sentry.io; frame-src 'self' https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		}

		# Caddy's automatic directory redirect is a relative 308. Google Search Console
		# records that as a redirect error for URLs without a trailing slash
		# (https://hoc.agency/social, https://hoc.agency/locations). One absolute 301.
		@indexWithoutSlash {
			not path */
			file {
				try_files {path}/index.html
			}
		}
		redir @indexWithoutSlash https://hoc.agency{path}/ 301

		# /pricing/index.html is the same page as /pricing/. One URL per page.
		@indexFile path_regexp indexfile ^(.*/)index.html$
		redir @indexFile https://hoc.agency{re.indexfile.1} 301

		# Old query URLs. An empty slug goes to the articles index. Unknown /articles/{slug}/ has no file and falls through to 404.
		@legacyArticleEmpty {
			path /articles/detail /articles/detail/ /articles /articles/
			query slug=
		}
		redir @legacyArticleEmpty https://hoc.agency/articles/ 301

		@legacyArticleDetail {
			path /articles/detail /articles/detail/
			query slug=*
		}
		redir @legacyArticleDetail https://hoc.agency/articles/{query.slug}/ 301

		@legacyArticleQuery {
			path /articles /articles/
			query slug=*
		}
		redir @legacyArticleQuery https://hoc.agency/articles/{query.slug}/ 301

		@static file {
			try_files {path} {path}/index.html
		}
		handle @static {
			file_server
		}
		handle {
			error 404
		}
	}

	handle_errors {
		root * /var/www/design
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}
}

:80 {
	import hoc_app
}

# Without this block Caddy sends http://www to https://www first, then to https://hoc.agency.
http://www.hoc.agency {
	redir https://hoc.agency{uri} permanent
}

www.hoc.agency {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	redir https://hoc.agency{uri} permanent
}

api.hoc.agency {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<EOF
User-agent: *
Disallow: /
EOF 200
	}

	import hoc_api_routes
}

hoc.agency {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	import hoc_app
}

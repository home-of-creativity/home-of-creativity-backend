{
	email admin@hoc.agency
}

(hoc_api_routes) {
	handle /api* {
		root * /var/www/hoc/public
		encode gzip
		request_body {
			max_size 512MB
		}
		php_fastcgi hoc-api:9000 {
			dial_timeout 10s
			read_timeout 10m
			write_timeout 10m
		}
		file_server
	}

	handle /auth* {
		root * /var/www/hoc/public
		encode gzip
		php_fastcgi hoc-api:9000 {
			dial_timeout 10s
			read_timeout 10m
			write_timeout 10m
		}
		file_server
	}

	handle /up {
		root * /var/www/hoc/public
		php_fastcgi hoc-api:9000
	}

	handle /storage* {
		root * /var/www/hoc/storage/app/public
		uri strip_prefix /storage
		header {
			Accept-Ranges bytes
			Cache-Control "public, max-age=86400"
		}
		file_server
	}
}

(hoc_app) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	@oldBase path /home-of-creativity-profile /home-of-creativity-profile/*
	handle @oldBase {
		uri strip_prefix /home-of-creativity-profile
		redir {scheme}://{host}{uri} permanent
	}

	import hoc_api_routes

	redir /staff /dashboard 308
	redir /staff/ /dashboard 308
	@oldStaff path_regexp oldstaff ^/staff(/.*)$
	redir @oldStaff /dashboard{re.oldstaff.1} 308

	redir /dashboard /dashboard/ 308

	handle /dashboard* {
		reverse_proxy hoc-dashboard:5173
	}

	handle {
		root * /var/www/design
		encode gzip
		try_files {path} {path}/ {path}/index.html /index.html
		file_server
	}
}

:80 {
	import hoc_app
}

www.hoc.agency {
	redir https://hoc.agency{uri} permanent
}

api.hoc.agency {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	import hoc_api_routes
}

hoc.agency {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	import hoc_app
}

# Placeholders only — never commit real tokens.
# GitHub does not run this API. Local Docker: parent compose.yaml.
# VPS: copy this file to .env on the server, then GitHub Actions
# deploys over SSH (secrets SSH_HOST, SSH_USER, SSH_PRIVATE_KEY — no password).
APP_NAME="Home of Creativity"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Production dashboard origin(s), comma-separated, e.g. http://203.0.113.10:5173,http://203.0.113.10
CORS_ALLOWED_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=home_of_creativity
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=change-me
N8N_TIMEOUT=12

META_GRAPH_URL=https://graph.facebook.com/v21.0
SOCIAL_GRAPH_TIMEOUT=20
SOCIAL_GRAPH_CONNECT_TIMEOUT=10
SOCIAL_GRAPH_UPLOAD_TIMEOUT=60
SOCIAL_TIMEZONE=Asia/Damascus
SOCIAL_LANDING_INSTAGRAM_HANDLE=homeofcreativity.sy
SOCIAL_LANDING_FACEBOOK_PAGE_ID=
SOCIAL_LANDING_FACEBOOK_HANDLE=homeofcreativity
# User token needs: pages_show_list, pages_manage_posts, pages_read_engagement, pages_read_user_content, pages_manage_engagement, pages_messaging
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_STRICT=false
TELEGRAM_BOT_SECRET=change-me-bot
TELEGRAM_BOT_USERNAME=
TELEGRAM_STAFF_CHAT_ID=
TELEGRAM_STAFF_BOT_TOKEN=
TELEGRAM_STAFF_BOT_SECRET=change-me-staff
TELEGRAM_STAFF_BOT_USERNAME=
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_SECRET=change-me-admin
TELEGRAM_ADMIN_IDS=
# Optional real HTTP/SOCKS proxy only, e.g. http://127.0.0.1:1080 — not a Cloudflare URL
TELEGRAM_PROXY=
# Webhook via Cloudflare: set TELEGRAM_WEBHOOK_URL to the tunnel origin (no trailing slash). Leave empty for polling.
TELEGRAM_WEBHOOK_URL=

# Google service account JSON path or raw JSON (Drive + Calendar)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
GOOGLE_CALENDAR_ID=primary

ELEVENLABS_API_KEY=
ELEVENLABS_TIMEOUT=60

ODOO_ENABLED=false
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_USE_JSON2=false
ODOO_TIMEOUT=12
ODOO_CURRENCY_CODE=SYP

CLICKUP_TOKEN=
CLICKUP_SPACE_ID=
CLICKUP_LIST_ID=
CLICKUP_LIST_SALES=
CLICKUP_LIST_PHOTOGRAPHY=
CLICKUP_LIST_CONTENT=
CLICKUP_LIST_DESIGN=
CLICKUP_LIST_PROGRAMMING=
CLICKUP_TIMEOUT=12
CLICKUP_STATUS_PROGRESS="in progress"
CLICKUP_STATUS_REVIEW=review
CLICKUP_STATUS_COMPLETE=complete
CLICKUP_STATUS_CANCELLED=canceled

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=30
# Stub Gemini responses during Playwright E2E (no Google API key required)
GEMINI_E2E_STUB=false

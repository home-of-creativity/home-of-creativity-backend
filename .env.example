# Placeholders only — never commit real tokens.
# GitHub does not run this API. Local Docker: parent compose.yaml.
# VPS: copy this file to .env on the server, then GitHub Actions
# deploys over SSH (secrets SSH_HOST, SSH_USER, SSH_PRIVATE_KEY — no password).
APP_NAME="Home of Creativity"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Production dashboard origin(s), comma-separated
CORS_ALLOWED_ORIGINS=https://hoc.agency,https://www.hoc.agency,https://api.hoc.agency

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=home_of_creativity
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=420

CACHE_STORE=database

# Reel uploads are remuxed to faststart (moov atom first) so clips play while downloading
FFMPEG_BINARY=ffmpeg

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Website contact form. Set CONTACT_MAIL_PASSWORD to the cPanel password for info@hoc.agency. Leave it empty to refuse sends.
CONTACT_MAIL_SCHEME=smtps
CONTACT_MAIL_HOST=premium319.web-hosting.com
CONTACT_MAIL_PORT=465
CONTACT_MAIL_USERNAME=info@hoc.agency
CONTACT_MAIL_PASSWORD=
CONTACT_MAIL_INFO=info@hoc.agency
CONTACT_MAIL_SALES=sales@hoc.agency
CONTACT_MAIL_SUPPORT=support@hoc.agency

N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=change-me
N8N_DRIVE_WEBHOOK_URL=
N8N_TIMEOUT=12

META_GRAPH_URL=https://graph.facebook.com/v21.0
SOCIAL_GRAPH_TIMEOUT=20
SOCIAL_GRAPH_CONNECT_TIMEOUT=10
SOCIAL_GRAPH_UPLOAD_TIMEOUT=60
SOCIAL_TIMEZONE=Asia/Damascus
SOCIAL_LANDING_INSTAGRAM_HANDLE=homeofcreativity.sy
SOCIAL_LANDING_FACEBOOK_PAGE_ID=
SOCIAL_LANDING_FACEBOOK_HANDLE=homeofcreativity
# User token needs: pages_show_list, pages_manage_posts, pages_read_engagement, pages_read_user_content, pages_manage_engagement, pages_messaging
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Threads App ID/Secret from Meta App Dashboard → App settings → Basic (Threads App ID).
# Valid OAuth Redirect URI in Meta must be exactly:
#   https://hoc.agency/auth/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://hoc.agency/auth/threads/callback
THREADS_DASHBOARD_URL=https://hoc.agency/dashboard/social/accounts
THREADS_ACCESS_TOKEN=
THREADS_GRAPH_URL=https://graph.threads.net/v1.0

# LinkedIn app Client ID/Secret from LinkedIn Developers → your app → Auth tab.
# Requires the Community Management API product with organization admin access.
# Valid Authorized redirect URL in LinkedIn must be exactly:
#   https://hoc.agency/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://hoc.agency/auth/linkedin/callback
LINKEDIN_DASHBOARD_URL=https://hoc.agency/dashboard/social/accounts
LINKEDIN_OAUTH_SCOPES=r_organization_social,w_organization_social,rw_organization_admin

TELEGRAM_BOT_TOKEN=
TELEGRAM_STRICT=false
TELEGRAM_BOT_SECRET=change-me-bot
TELEGRAM_BOT_USERNAME=
TELEGRAM_STAFF_CHAT_ID=
TELEGRAM_STAFF_BOT_TOKEN=
TELEGRAM_STAFF_BOT_SECRET=change-me-staff
TELEGRAM_STAFF_BOT_USERNAME=
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_SECRET=change-me-admin
TELEGRAM_ADMIN_IDS=
# Developer alert bot. Leave tokens empty to disable outbound alerts.
TELEGRAM_DEV_BOT_TOKEN=
TELEGRAM_DEV_BOT_SECRET=change-me-dev
TELEGRAM_DEV_IDS=
TELEGRAM_DEV_CHAT_ID=
DEV_HEALTH_URL=https://api.hoc.agency/up
# Inside Docker the scheduler probes Caddy directly. Leave empty outside compose.
DEV_HEALTH_INTERNAL_URL=
SENTRY_LARAVEL_DSN=
SENTRY_SEND_DEFAULT_PII=false
# Sentry issue alerts: POST https://api.hoc.agency/api/integrations/sentry
# Header X-Webhook-Secret = this value. Leave empty to reject the webhook.
SENTRY_WEBHOOK_SECRET=
SENTRY_DSN=
# Optional real HTTP/SOCKS proxy only, e.g. http://127.0.0.1:1080 — not a Cloudflare URL
TELEGRAM_PROXY=
# Webhook via Cloudflare: set TELEGRAM_WEBHOOK_URL to the tunnel origin (no trailing slash). Leave empty for polling.
TELEGRAM_WEBHOOK_URL=

# WhatsApp Cloud API (client bot). Callback URL: https://api.hoc.agency/api/bot/whatsapp/webhook
# Meta App → WhatsApp → Configuration: verify token + subscribe to messages.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional. Defaults to META_GRAPH_URL / graph.facebook.com/v21.0
WHATSAPP_GRAPH_URL=
# Bot SLA follow-ups (hours). Laravel cron ops:process-bot-sla; n8n optional retry via /integrations/telegram/notify.
BOT_SLA_QUOTE_HOURS=2
BOT_SLA_RECEIPT_HOURS=12
BOT_SLA_RECEIPT_SALES_HOURS=24
BOT_SLA_RECEIPT_UNCONFIRMED_HOURS=3
BOT_SLA_REVISION_HOURS=1
BOT_SLA_SUPPORT_HOURS=1
BOT_SLA_PROFILE_HOURS=24
BOT_SLA_DIGEST_HOUR=9

# Optional. If empty, the app uses storage/app/private/google-sa.json (written on deploy from GOOGLE_SERVICE_ACCOUNT_JSON_B64).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
GOOGLE_DRIVE_WATCH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_SEARCH_SITE_URL=https://hoc.agency/
GOOGLE_SEARCH_SITEMAP_URL=https://hoc.agency/sitemap.xml
INDEXNOW_KEY=c4e8a91b7d2f40c6a5e13b8f0d9c276a

ELEVENLABS_API_KEY=
ELEVENLABS_TIMEOUT=60

ODOO_ENABLED=false
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_USE_JSON2=false
ODOO_TIMEOUT=12
ODOO_CURRENCY_CODE=SYP

CLICKUP_TOKEN=
CLICKUP_SPACE_ID=
CLICKUP_LIST_ID=
CLICKUP_LIST_SALES=
CLICKUP_LIST_PHOTOGRAPHY=
CLICKUP_LIST_CONTENT=
CLICKUP_LIST_DESIGN=
CLICKUP_LIST_PROGRAMMING=
CLICKUP_TIMEOUT=12
CLICKUP_STATUS_PROGRESS="in progress"
CLICKUP_STATUS_REVIEW=review
CLICKUP_STATUS_COMPLETE=complete
CLICKUP_STATUS_CANCELLED=canceled

# AI Studio auth key restricted to Gemini API. Standard / Maps GOOGLE_API_KEY is rejected (2026).
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=30
# Stub Gemini responses during Playwright E2E (no Google API key required)
GEMINI_E2E_STUB=false
# Translate Gemini briefs to Arabic before ClickUp (Google Translate, then Cloud Translation if a key works)
GOOGLE_TRANSLATE_ENABLED=true
GOOGLE_TRANSLATE_API_KEY=
